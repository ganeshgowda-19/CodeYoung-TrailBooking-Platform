# Database Configuration
# PostgreSQL connection string for Docker / Production
DATABASE_URL="postgresql://trialflow_user:trialflow_pass@localhost:5432/trialflow_db?schema=public"

# For SQLite fallback during rapid local development without Docker:
# DATABASE_URL="file:./dev.db"

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Business Configuration
SESSION_DURATION_MINUTES=30
MENTOR_WORK_START=09:00
MENTOR_WORK_END=21:00
MAX_DAILY_CLASSES_PER_MENTOR=2
