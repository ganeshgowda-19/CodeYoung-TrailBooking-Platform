{
  "name": "trialflow",
  "version": "1.0.0",
  "private": true,
  "description": "Smart Trial Class Booking Platform",
  "scripts": {
    "setup": "npm install && npm run build:backend && npm run build:frontend",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:server": "cd backend && npm run dev",
    "dev:client": "cd frontend && npm run dev",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "cd backend && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "build:server": "cd backend && npm run build",
    "build:client": "cd frontend && npm run build",
    "db:seed": "cd backend && npm run db:seed",
    "db:push": "cd backend && npm run db:push",
    "test": "cd backend && npm run test"
  },
  "devDependencies": {
    "@types/luxon": "^3.4.2",
    "@types/node": "^20.11.24",
    "concurrently": "^8.2.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@prisma/client": "^5.10.2",
    "dotenv": "^16.4.5",
    "luxon": "^3.4.4",
    "prisma": "^5.10.2"
  }
}
